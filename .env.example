# Copy this file to .env and fill in real values. Never commit .env.

# --- Environment ---
ENVIRONMENT=development

# --- Security ---
# Password for the Security Audit panel. Leave empty to keep the panel locked.
# Use a long random value, e.g.: python -c "import secrets; print(secrets.token_urlsafe(24))"
ADMIN_PASSWORD=
ADMIN_MAX_ATTEMPTS=5

# --- Ollama (keep on localhost for zero data egress) ---
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_TIMEOUT=180
CHAT_MODEL=llama3.2:3b
EMBED_MODEL=nomic-embed-text
MODEL_KEEP_ALIVE=30m

# --- Retrieval / generation ---
# Changing EMBED_MODEL, CHUNK_SIZE or CHUNK_OVERLAP triggers an automatic re-index.
TOP_K=4
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
MAX_ANSWER_TOKENS=300
ANSWER_CACHE_SIZE=128

# --- Prompt-injection defences ---
# Max cosine distance to the nearest policy chunk; further = off-topic, refused without calling the LLM.
# Calibrated for nomic-embed-text (policy questions ~0.20-0.42, off-topic >0.50). Recalibrate if you change EMBED_MODEL.
RELEVANCE_MAX_DISTANCE=0.50
# Blocked requests per browser session before the chat is paused, and for how long.
MAX_BLOCKED_PER_SESSION=3
BLOCK_COOLDOWN_SECONDS=300

# --- Third-party telemetry off ---
ANONYMIZED_TELEMETRY=False
